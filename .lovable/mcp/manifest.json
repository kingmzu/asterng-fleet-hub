{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bokkpgpklwrvvvbgeewr.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "asterng",
      "version": "0.1.0",
      "title": "AsterNG"
    },
    "tools": [
      {
        "name": "list_riders",
        "title": "List riders",
        "description": "List riders in the ASTERNG fleet, optionally filtered by status or a name/phone search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "suspended",
                "all"
              ],
              "default": "all",
              "description": "Filter by rider status."
            },
            "search": {
              "type": "string",
              "description": "Match against rider name or phone number."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_motorcycles",
        "title": "List motorcycles",
        "description": "List motorcycles in the ASTERNG fleet with plate number, model and assignment status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Filter by motorcycle status, e.g. available or assigned."
            },
            "search": {
              "type": "string",
              "description": "Match against plate number or model."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_remittances",
        "title": "List remittances",
        "description": "List recent rider remittance payments, optionally filtered by status or date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Filter by remittance status, e.g. paid, pending or overdue."
            },
            "from_date": {
              "type": "string",
              "description": "Earliest remittance date (YYYY-MM-DD)."
            },
            "to_date": {
              "type": "string",
              "description": "Latest remittance date (YYYY-MM-DD)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "fleet_summary",
        "title": "Fleet summary",
        "description": "Summarise the ASTERNG fleet: rider and motorcycle counts, outstanding balances, and remittance and expense totals for a recent period.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30,
              "description": "Number of past days to total remittances and expenses over."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
